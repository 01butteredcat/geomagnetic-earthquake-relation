# Python 虛擬環境——用以下指令重建：
#   python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
.venv/

__pycache__/
*.pyc
.DS_Store
*Zone.Identifier*

# 分析中間檔／輸出（約 850MB）——全部可以用 scripts/
# 對下面的原始資料、以專案固定的亂數種子（20260805）重新產生。
# 不值得版本控制；見 NOTES.md。
data/

# --- 原始地磁日資料，逐組 ------------------------------------
# G1..G23 合計約 18GB——遠超過 git repo 該放的量（也
# 超過 Git LFS 的免費額度）。這裡排除；每組自己的 NOTES.md
# （很小、有價值的逐組文件）用 `!` 否定規則
# 明確保留。下面必須寫 `Gx/*`（不是 `Gx/`）——如果整個目錄都被忽略，
# gitignore 就無法對目錄裡的檔案套用否定規則。
# 怎麼取得這些資料，見 README.md 的「資料要自己準備」一節。
G1/*
!G1/NOTES.md
G2_G3/*
!G2_G3/NOTES.md
G4/*
!G4/NOTES.md
G5/*
!G5/NOTES.md
G6_G7_G8/*
!G6_G7_G8/NOTES.md
G9/*
!G9/NOTES.md
G10/*
!G10/NOTES.md
G11/*
!G11/NOTES.md
G12/*
!G12/NOTES.md
G13/*
!G13/NOTES.md
G14/*
!G14/NOTES.md
G15/*
!G15/NOTES.md
G16/*
!G16/NOTES.md
G17/*
!G17/NOTES.md
G18/*
!G18/NOTES.md
G19/*
!G19/NOTES.md
G20/*
!G20/NOTES.md
G21/*
!G21/NOTES.md
G22/*
!G22/NOTES.md
G23/*
!G23/NOTES.md

# --- 地震儀／加速度儀波形 + 儀器響應資料 ---------
# 約 384MB，全是二進位檔（mseed 波形 + SAC PoleZero 檔），沒有要保留的
# 文件檔——2026-09-14 從上層目錄搬進來，和上面的 Gx 一樣
# 是因為對 git 來說太大。
seismometer/

# AI 助理相關檔案只留在本機（筆記在 NOTES.md；本機的 CLAUDE.md 只是匯入它）
CLAUDE.md
**/CLAUDE.md
.claude/
